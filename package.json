{
  "name": "invoiceplane",
  "version": "2.0.0",
  "description": "InvoicePlane is a self-hosted open source application for managing your invoices, clients and payments",
  "homepage": "https://invoiceplane.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvoicePlane/InvoicePlane.git"
  },
  "author": "InvoicePlane Developers & Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://development.invoiceplane.com"
  },
  "scripts": {
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production",
    "production": "mix --production"
  },
  "devDependencies": {
    "laravel-mix": "^6.0.49",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.54.0",
    "sass-loader": "^12.1.0"
  },
  "dependencies": {
    "@coreui/coreui": "^2.0.3",
    "autosize": "^4.0.2",
    "bootstrap": "^4.1.1",
    "bootstrap-datepicker": "^1.8.0",
    "bootstrap-notify": "^3.1.3",
    "chosen-js": "^1.8.7",
    "daterangepicker": "^3.0.3",
    "font-awesome": "^4.7.0",
    "ionicons": "^4.2.4",
    "jquery": "^3.3.1",
    "jquery-slimscroll": "^1.3.8",
    "jquery-ui-dist": "^1.12.1",
    "moment": "^2.22.2",
    "popper.js": "^1.14.3",
    "typeahead.js": "^0.10.1"
  }
