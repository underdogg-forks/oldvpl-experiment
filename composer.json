{
    "name": "underdogg-forks/invoiceplane",
    "version": "2.0.0",
    "description": "InvoicePlane is a self-hosted open source application for managing your invoices, clients and payments",
    "homepage": "https://invoiceplane.com",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1",
        "doctrine/dbal": "^3.0",
        "dompdf/dompdf": "^2.0",
        "ifsnop/mysqldump-php": "^2.12",
        "knplabs/knp-snappy": "^1.4",
        "laravel/framework": "^10.0",
        "laravelcollective/html": "^6.4",
        "mollie/mollie-api-php": "^2.0",
        "paypal/paypal-checkout-sdk": "^1.0",
        "sonata-project/exporter": "^3.0",
        "stripe/stripe-php": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Addons\\": "custom/addons/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
