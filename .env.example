## App Key
# The app key is used to encrypt data of your application and
# is automatically set in the setup. Do not change it manually!
APP_KEY=SomeRandomStringWith32Characters

## App Settings
APP_NAME=InvoicePlane
APP_ENV=production
APP_DEBUG=false

## App URL
# If you have problems with broken links try to set the correct URL
# of your application here. No trailing slash!
APP_URL=http://localhost

## Database Settings
# The following settings are used to connect to your database
# They are set during the setup. Change them here if you move
# to another database or server if needed.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invoiceplane
DB_USERNAME=invoiceplane
DB_PASSWORD=secret
DB_PREFIX=

## Logging Settings (Laravel 10)
# Configure logging channels and levels
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

## Driver Settings (Laravel 10)
# The following settings define which applications should be used
# for various application parts. Only change them if you know what
# you are doing.
BROADCAST_DRIVER=log
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

## Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

## Mail Settings (Laravel 10)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

## AWS Settings (for S3 filesystem)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

